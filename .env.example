# Where each early-access response is forwarded (Zapier / Make / HubSpot / Google Sheets / your API).
# Receives a JSON POST. Required on Vercel. Leave empty to write to data/responses.jsonl (local dev only).
WHITELABEL_WEBHOOK_URL=

# Secret for the team-only results page: /results?token=<value>
# Leave empty to disable the page.
RESULTS_TOKEN=
